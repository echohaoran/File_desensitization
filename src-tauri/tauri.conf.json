{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "文件脱敏与还原工具",
  "version": "0.1.3",
  "identifier": "com.desens.filetool",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "文件脱敏与还原工具",
        "width": 1360,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../desktop/resources/icon.ico"]
  }
}
